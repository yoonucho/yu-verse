{
  "name": "yu-verse",
  "private": true,
  "scripts": {
    "yu-calendar": "pnpm --filter yu-calendar",
    "yu-books": "pnpm --filter yu-books",
    "build": "pnpm build:all",
    "build:all": "pnpm --filter yu-calendar build && pnpm --filter yu-books build",
    "build:calendar": "pnpm --filter yu-calendar build",
    "build:books": "pnpm --filter yu-books build",
    "test": "pnpm -r test",
    "test:watch": "jest --watch",
    "test:e2e:books": "playwright test --project yu-books",
    "test:e2e:calendar": "playwright test --project yu-calendar"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.1",
    "jest": "^29.7.0",
    "jest-watch-typeahead": "^3.0.1",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.5.0"
}
